---
/**
 * ImagePlaceholder — drop this inside any MDX section or component
 * to mark where a screenshot / mockup will go.
 * Replace `src` with the real image path when ready.
 */
import { Image } from "astro:assets";
import { resolveImage } from "../../utils/images";

interface Props {
  label?: string;
  aspectRatio?: string; // e.g. "16/9", "4/3", "3/2"
  src?: string;
  alt?: string;
}

const {
  label = "Add screenshot",
  aspectRatio = "16/9",
  src,
  alt,
} = Astro.props;

const imageData = await resolveImage(src);
---

<figure class="img-placeholder-wrap" style={imageData || src ? '' : `aspect-ratio:${aspectRatio};`}>
  {imageData ? (
    <Image
      src={imageData}
      alt={alt ?? label}
      widths={[900, 1800, 3000, 3600]}
      sizes="(max-width: 900px) 100vw, 900px"
      format="png"
      quality={100}
      style="width:100%;height:auto;display:block;"
    />
  ) : src ? (
    <img src={src} alt={alt ?? label} style="width:100%;height:auto;display:block;" />
  ) : (
    <div class="img-placeholder-inner">
      <!-- Camera / image icon -->
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
        stroke-linejoin="round" aria-hidden="true">
        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
        <circle cx="12" cy="13" r="4"/>
      </svg>
      <span class="img-placeholder-label">{label}</span>
    </div>
  )}
</figure>


<style>
  /* ── Vercel sandbox-style showcase frame (light) ─────────────── */
  .img-placeholder-wrap {
    display: block;
    width: 100%;
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid var(--border);
    background-color: var(--showcase-bg);
    margin: 2rem 0;
    position: relative;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.02),
      0 4px 12px rgba(0, 0, 0, 0.03),
      0 16px 32px rgba(0, 0, 0, 0.02);
  }

  /* Image fills the container — outer border is the only frame */
  .img-placeholder-wrap :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    border: none;
    border-radius: 0;
  }

  /* Placeholder state (no image yet) */
  .img-placeholder-inner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    color: #a1a1aa;
  }

  .img-placeholder-label {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #a1a1aa;
  }
</style>
