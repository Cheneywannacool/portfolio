---
/**
 * Reflection — "What would I do differently?"
 * A candid retrospective note — signals design maturity.
 *
 * Rendered the same way as the rest of the case-study "list item" style:
 * a line-icon + serif title on the left, description on the right.
 */

interface Props {
  reflection?: string;
  reflectionTitle?: string;
}

const { reflection, reflectionTitle } = Astro.props;
if (!reflection) return;

// Speech-bubble icon — universal "looking back" marker for the single point.
const CHAT_ICON = `<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>`;
---

<section style="margin-bottom:3.5rem;">
  <!-- Section title — matches Impact / Deep dives heading style -->
  <div style="display:flex;align-items:center;gap:0.625rem;margin-bottom:1.5rem;">
    <div style="width:2px;height:1.25rem;border-radius:9999px;background:var(--coral);flex-shrink:0;"></div>
    <h2 style="
      font-family: var(--font-serif);
      font-style: normal;
      font-weight: 700;
      font-size: 1.65rem;
      letter-spacing: -0.025em;
      color: var(--text);
      margin: 0;
    ">Reflection</h2>
  </div>

  <div class="reflect-item">
    <div class="reflect-item-left">
      <svg class="reflect-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={CHAT_ICON} />
      <h3 class="reflect-title">{reflectionTitle ?? "Looking back"}</h3>
    </div>
    <p class="reflect-desc">{reflection}</p>
  </div>
</section>

<style>
  .reflect-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
    gap: 2.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
  }

  @media (max-width: 620px) {
    .reflect-item {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }

  .reflect-item-left {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .reflect-icon {
    color: var(--coral);
    flex-shrink: 0;
  }

  .reflect-title {
    font-family: var(--font-serif);
    font-style: normal;
    font-weight: 400;
    font-size: 1.35rem;
    letter-spacing: -0.015em;
    line-height: 1.2;
    color: var(--text);
    margin: 0;
  }

  .reflect-desc {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 300;
    line-height: 1.7;
    color: var(--text-2);
    margin: 0;
    align-self: start;
  }
</style>
