---
const steps = [
  {
    number: "01",
    title: "Integrate the package",
    description: "Replaces the legacy design system as the design source",
    kind: "integrate",
  },
  {
    number: "02",
    title: "Run baseline check",
    description: "Runs ds-token-guard.sh for any remaining legacy values",
    kind: "baseline",
  },
  {
    number: "03",
    title: "Rebuild flow by flow",
    description: "Rebuilds screens using new design system components flow by flow",
    kind: "rebuild",
  },
  {
    number: "04",
    title: "Re-run the guard",
    description: "Confirms cleanup and catches regressions before merge",
    kind: "guard",
  },
];
---

<figure class="migration-diagram" aria-label="Four step migration process repeated flow by flow">
  <div class="migration-diagram__grid">
    {steps.map((step, index) => (
      <section class="migration-step" style={`--delay: ${index * 120}ms;`}>
        <div class={`migration-step__visual migration-step__visual--${step.kind}`} aria-hidden="true">
          {step.kind === "integrate" && (
            <div class="migration-integrate">
              <span class="migration-integrate__source"></span>
              <span class="migration-integrate__line"></span>
              <span class="migration-integrate__dot"></span>
            </div>
          )}

          {step.kind === "baseline" && (
            <div class="migration-grid">
              {Array.from({ length: 18 }).map((_, cellIndex) => (
                <span class={cellIndex === 1 || cellIndex === 4 || cellIndex === 7 || cellIndex === 9 || cellIndex === 12 || cellIndex === 14 ? "is-strong" : cellIndex === 16 ? "is-mid" : ""}></span>
              ))}
            </div>
          )}

          {step.kind === "rebuild" && (
            <div class="migration-bars">
              <span class="migration-bars__label"></span>
              <span class="migration-bars__row"></span>
              <span class="migration-bars__label"></span>
              <span class="migration-bars__row"></span>
              <span class="migration-bars__label is-soft"></span>
              <span class="migration-bars__row"></span>
            </div>
          )}

          {step.kind === "guard" && (
            <div class="migration-guard">
              <div class="migration-guard__rows">
                <span></span>
                <span></span>
                <span></span>
              </div>
              <span class="migration-guard__check"></span>
            </div>
          )}
        </div>

        <div class="migration-step__copy">
          <p class="migration-step__number">{step.number}</p>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </div>
      </section>
    ))}
  </div>

  <div class="migration-repeat" aria-hidden="true">
    <svg viewBox="0 0 260 34" focusable="false">
      <path d="M35 10v4c0 6 5 11 11 11h168c6 0 11-5 11-11v-4"></path>
      <path d="M35 10l-6 6M35 10l6 6"></path>
      <path d="M225 10l-6 6M225 10l6 6"></path>
    </svg>
    <p>Repeat</p>
  </div>
</figure>

<style>
  .migration-diagram {
    margin: 2rem 0 2.25rem;
    padding: 0;
  }

  .migration-diagram__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.9rem;
    align-items: stretch;
  }

  .migration-step {
    min-width: 0;
    padding: clamp(1rem, 2.2vw, 1.25rem);
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--card);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.02),
      0 4px 12px rgba(0, 0, 0, 0.03);
    opacity: 0;
    transform: translateY(10px);
    animation: migration-step-in 520ms cubic-bezier(0.16, 1, 0.3, 1) var(--delay) forwards;
  }

  .migration-step__visual {
    height: 5.35rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-bottom: 0.15rem;
    color: #7440de;
  }

  .migration-step__copy {
    padding-top: 0.9rem;
  }

  .migration-step__number {
    margin: 0 0 0.72rem;
    color: var(--coral);
    font-size: 0.72rem;
    font-weight: 760;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  .migration-step h3 {
    margin: 0;
    color: var(--text);
    font-family: var(--font-sans);
    font-size: clamp(0.78rem, 1.3vw, 0.88rem);
    font-weight: 760;
    line-height: 1.25;
    letter-spacing: 0;
    text-transform: none;
  }

  .migration-step__copy p:last-child {
    margin: 0.3rem 0 0;
    color: var(--text-3);
    font-size: clamp(0.72rem, 1.2vw, 0.78rem);
    font-weight: 400;
    line-height: 1.38;
  }

  .migration-integrate {
    display: flex;
    align-items: center;
    width: 100%;
  }

  .migration-integrate__source,
  .migration-integrate__dot {
    flex: 0 0 auto;
    border-radius: 999px;
  }

  .migration-integrate__source {
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid color-mix(in srgb, #7440de 14%, var(--border));
    background: var(--card);
  }

  .migration-integrate__line {
    position: relative;
    flex: 1 1 auto;
    min-width: 2.2rem;
    height: 1px;
    margin: 0 0.55rem;
    background: color-mix(in srgb, #7440de 76%, transparent);
  }

  .migration-integrate__line::after {
    content: "";
    position: absolute;
    right: -0.1rem;
    top: 50%;
    width: 0.28rem;
    height: 0.28rem;
    border-radius: 999px;
    background: #7440de;
    transform: translateY(-50%);
  }

  .migration-integrate__dot {
    width: 2.42rem;
    height: 2.42rem;
    background: #7440de;
    box-shadow: 0 0 0 1px color-mix(in srgb, #7440de 14%, transparent);
  }

  .migration-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0.34rem;
    width: min(100%, 8.4rem);
    align-content: start;
    margin: 0 auto;
  }

  .migration-grid span {
    aspect-ratio: 1;
    background: color-mix(in srgb, #7440de 8%, var(--card));
  }

  .migration-grid span.is-strong {
    background: #7440de;
  }

  .migration-grid span.is-mid {
    background: color-mix(in srgb, #7440de 60%, #ffffff);
  }

  .migration-bars {
    display: grid;
    grid-template-columns: minmax(1.7rem, 2.15rem) minmax(4.6rem, 1fr);
    gap: 0.32rem 0.48rem;
    width: 100%;
    align-items: center;
  }

  .migration-bars span {
    height: 1.18rem;
    border-radius: 0.02rem;
  }

  .migration-bars__label {
    background: #7440de;
  }

  .migration-bars__label.is-soft {
    background: color-mix(in srgb, #7440de 58%, #ffffff);
  }

  .migration-bars__row {
    background: color-mix(in srgb, #7440de 8%, var(--card));
  }

  .migration-guard {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
  }

  .migration-guard__rows {
    display: grid;
    width: calc(100% - 0.35rem);
    gap: 0.4rem;
  }

  .migration-guard__rows span {
    height: 1.18rem;
    border-radius: 0.02rem;
    background: color-mix(in srgb, #7440de 8%, var(--card));
  }

  .migration-guard__check {
    position: absolute;
    right: 0;
    top: 50%;
    width: 2.14rem;
    height: 2.14rem;
    border-radius: 999px;
    background: #7440de;
    transform: translateY(-50%);
  }

  .migration-guard__check::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 47%;
    width: 0.78rem;
    height: 0.42rem;
    border-left: 0.18rem solid #ffffff;
    border-bottom: 0.18rem solid #ffffff;
    border-radius: 0.02rem;
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  .migration-repeat {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(15rem, 34%);
    margin: 0.9rem 10.5% 0 auto;
    color: #7440de;
  }

  .migration-repeat svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .migration-repeat path,
  .migration-repeat line {
    fill: none;
    stroke: color-mix(in srgb, var(--text-3) 48%, transparent);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.75;
    stroke-dasharray: 300;
    stroke-dashoffset: 300;
    animation: migration-draw 950ms cubic-bezier(0.16, 1, 0.3, 1) 520ms forwards;
  }

  .migration-repeat circle {
    display: none;
  }

  .migration-repeat p {
    margin: -0.15rem 0 0;
    color: #7440de;
    font-size: 0.72rem;
    font-weight: 760;
    line-height: 1;
  }

  @keyframes migration-step-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes migration-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (max-width: 760px) {
    .migration-diagram__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.9rem;
    }

    .migration-repeat {
      width: 66%;
      margin-right: 0;
    }
  }

  @media (max-width: 460px) {
    .migration-diagram__grid {
      grid-template-columns: 1fr;
    }

    .migration-step {
      display: grid;
      grid-template-columns: 7.8rem 1fr;
      gap: 1rem;
      align-items: center;
    }

    .migration-step__copy {
      margin-top: 0;
    }

    .migration-repeat {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .migration-step {
      opacity: 1;
      transform: none;
      animation: none;
    }

    .migration-repeat path,
    .migration-repeat line {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>
