---
interface Stop {
  year: string;
  location: string;
  description: string;
  photoSrc?: string;
}

interface Props {
  stops: Stop[]; // newest-first; will be reversed so the story flows oldest -> newest
}

const { stops } = Astro.props;
const chrono = [...stops].reverse();

// Compute proportional positions along the timeline based on year
const years = chrono.map((s) => Number(s.year));
const minYear = Math.min(...years);
const maxYear = Math.max(...years);
const range = Math.max(1, maxYear - minYear);
const positions = years.map((y) => ((y - minYear) / range) * 100);
---

<div class="filmstrip" data-count={chrono.length}>
  <div class="film-track" tabindex="0" aria-label="Journey filmstrip">
    {chrono.map((stop, i) => (
      <article
        class={`film-panel${i === 0 ? " is-active" : ""}`}
        data-idx={i}
        aria-roledescription="slide"
        aria-label={`${stop.year} — ${stop.location}`}
      >
        {stop.photoSrc ? (
          <img
            class="film-photo"
            src={stop.photoSrc}
            alt={stop.location}
            loading={i < 2 ? "eager" : "lazy"}
          />
        ) : (
          <div class="film-photo film-photo-empty" aria-hidden="true"></div>
        )}

        <div class="film-shade" aria-hidden="true"></div>

        <div class="film-content">
          <span class="film-year">{stop.year}</span>

          <h3 class="film-location">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
              aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0118 0z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
            {stop.location}
          </h3>

          <p class="film-desc">{stop.description}</p>
        </div>
      </article>
    ))}
  </div>

  <div class="film-controls">
    <button class="film-btn" data-dir="-1" aria-label="Previous stop">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M15 18l-6-6 6-6" />
      </svg>
    </button>

    <div class="film-timeline" role="tablist" aria-label="Journey timeline">
      <div class="film-tl-rail" aria-hidden="true"></div>
      <div
        class="film-tl-fill"
        style={`width: ${positions[0]}%`}
        aria-hidden="true"
      ></div>
      {chrono.map((stop, i) => (
        <button
          class={`film-tick${i === 0 ? " is-active" : ""}`}
          data-idx={i}
          data-pos={positions[i]}
          style={`left: ${positions[i]}%`}
          role="tab"
          aria-label={`Jump to ${stop.year} ${stop.location}`}
        >
          <span class="film-tick-dot" aria-hidden="true"></span>
          <span class="film-tick-year">{stop.year}</span>
        </button>
      ))}
    </div>

    <button class="film-btn" data-dir="1" aria-label="Next stop">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 18l6-6-6-6" />
      </svg>
    </button>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>(".filmstrip");
  if (root) {
    const track = root.querySelector<HTMLElement>(".film-track")!;
    const fill = root.querySelector<HTMLElement>(".film-tl-fill")!;
    const panels = Array.from(root.querySelectorAll<HTMLElement>(".film-panel"));
    const ticks = Array.from(root.querySelectorAll<HTMLButtonElement>(".film-tick"));
    const btns = Array.from(root.querySelectorAll<HTMLButtonElement>(".film-btn"));

    let current = 0;

    const setActive = (idx: number) => {
      current = Math.max(0, Math.min(panels.length - 1, idx));
      panels.forEach((p, i) => p.classList.toggle("is-active", i === current));
      ticks.forEach((t, i) => t.classList.toggle("is-active", i === current));
      const pos = Number(ticks[current]?.dataset.pos ?? 0);
      fill.style.width = `${pos}%`;
    };

    const scrollTo = (idx: number, smooth = true) => {
      const wrapped = ((idx % panels.length) + panels.length) % panels.length;
      const panel = panels[wrapped];
      if (!panel) return;
      panel.scrollIntoView({ behavior: smooth ? "smooth" : "auto", inline: "center", block: "nearest" });
    };

    // Sync active state with scroll position via IntersectionObserver
    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible) {
          const idx = Number((visible.target as HTMLElement).dataset.idx);
          setActive(idx);
        }
      },
      { root: track, threshold: [0.5, 0.7, 0.9] }
    );
    panels.forEach((p) => io.observe(p));

    ticks.forEach((tick) => {
      tick.addEventListener("click", () => scrollTo(Number(tick.dataset.idx)));
    });

    btns.forEach((btn) => {
      btn.addEventListener("click", () => scrollTo(current + Number(btn.dataset.dir)));
    });

    track.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") { e.preventDefault(); scrollTo(current + 1); }
      else if (e.key === "ArrowLeft") { e.preventDefault(); scrollTo(current - 1); }
    });

    // ── Auto-scroll ─────────────────────────────────────────────
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const AUTO_MS = 5000;
    let autoTimer: ReturnType<typeof setInterval> | null = null;
    let paused = false;

    const startAuto = () => {
      if (prefersReducedMotion || autoTimer) return;
      autoTimer = setInterval(() => {
        if (!paused) scrollTo(current + 1);
      }, AUTO_MS);
    };
    const stopAuto = () => {
      if (autoTimer) { clearInterval(autoTimer); autoTimer = null; }
    };

    // Only run while the filmstrip is on screen
    const visibilityIO = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) startAuto();
          else stopAuto();
        });
      },
      { threshold: 0.25 }
    );
    visibilityIO.observe(root);

    // Pause briefly when user interacts
    const pauseFor = (ms: number) => {
      paused = true;
      window.setTimeout(() => { paused = false; }, ms);
    };
    root.addEventListener("pointerenter", () => { paused = true; });
    root.addEventListener("pointerleave", () => { paused = false; });
    track.addEventListener("scroll", () => pauseFor(2000), { passive: true });
    ticks.forEach((t) => t.addEventListener("click", () => pauseFor(8000)));
    btns.forEach((b) => b.addEventListener("click", () => pauseFor(8000)));
  }
</script>

<style>
  .filmstrip {
    --peek: 6vw;
    --panel-radius: 1.5rem;
    width: 100%;
  }

  /* ── Track ─────────────────────────────────────────────────── */
  .film-track {
    display: flex;
    gap: 1.25rem;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 0.5rem var(--peek) 1.25rem;
    margin: 0 calc(var(--peek) * -1);
    scroll-behavior: smooth;
  }
  .film-track::-webkit-scrollbar { display: none; }
  .film-track:focus { outline: none; }
  .film-track:focus-visible {
    outline: 2px solid var(--coral);
    outline-offset: 4px;
    border-radius: var(--panel-radius);
  }

  /* ── Panel ─────────────────────────────────────────────────── */
  .film-panel {
    position: relative;
    flex: 0 0 calc(100% - (var(--peek) * 2));
    height: clamp(440px, 62vh, 640px);
    scroll-snap-align: center;
    border-radius: var(--panel-radius);
    overflow: hidden;
    background: var(--bg-alt);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
    transform: scale(0.96);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .film-panel.is-active { transform: scale(1); }

  @media (max-width: 700px) {
    .filmstrip { --peek: 5vw; }
    .film-panel { height: clamp(420px, 70vh, 560px); }
  }

  .film-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.05);
    transition: transform 1s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .film-panel.is-active .film-photo { transform: scale(1); }

  .film-photo-empty {
    background: linear-gradient(135deg, var(--bg-alt), var(--coral-dim));
  }

  .film-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.72) 0%,
      rgba(0, 0, 0, 0.45) 28%,
      rgba(0, 0, 0, 0.05) 60%,
      rgba(0, 0, 0, 0) 100%
    );
    pointer-events: none;
  }

  /* ── Content overlay ───────────────────────────────────────── */
  .film-content {
    position: absolute;
    left: clamp(1.5rem, 4vw, 2.75rem);
    right: clamp(1.5rem, 4vw, 2.75rem);
    bottom: clamp(1.5rem, 4vw, 2.75rem);
    color: #fff;
    max-width: 38rem;
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.55s cubic-bezier(0.22, 1, 0.36, 1) 0.15s,
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1) 0.15s;
  }
  .film-panel.is-active .film-content {
    opacity: 1;
    transform: translateY(0);
  }

  .film-year {
    display: block;
    font-family: var(--font-serif);
    
    font-weight: 400;
    font-size: clamp(3.5rem, 8vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: #fff;
    margin-bottom: 0.4rem;
  }

  .film-location {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: "Manrope", system-ui, sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.95);
    margin: 0 0 0.85rem;
  }

  .film-desc {
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.88);
    margin: 0;
    max-width: 36rem;
  }

  /* ── Controls ──────────────────────────────────────────────── */
  .film-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .film-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--text-2);
    cursor: pointer;
    transition:
      border-color 0.2s,
      color 0.2s,
      transform 0.15s;
  }
  .film-btn:hover {
    border-color: var(--coral-mid);
    color: var(--coral);
  }
  .film-btn:active {
    transform: scale(0.94);
  }

  /* ── Timeline ──────────────────────────────────────────────── */
  .film-timeline {
    position: relative;
    flex: 1;
    height: 3rem;
    margin: 0 0.75rem;
    padding-top: 0.5rem;
  }

  .film-tl-rail,
  .film-tl-fill {
    position: absolute;
    top: 0.85rem;
    left: 0;
    height: 2px;
    border-radius: 9999px;
    pointer-events: none;
  }
  .film-tl-rail {
    width: 100%;
    background: var(--border);
  }
  .film-tl-fill {
    background: var(--coral);
    width: 0;
    transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .film-tick {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding: 0;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--text-3);
    font-family: "Manrope", system-ui, sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    transition: color 0.2s;
  }
  .film-tick:hover { color: var(--coral); }
  .film-tick.is-active { color: var(--coral); }

  .film-tick-dot {
    width: 10px;
    height: 10px;
    border-radius: 9999px;
    background: var(--bg, #fff);
    border: 2px solid var(--border);
    box-shadow: 0 0 0 3px var(--bg, #fff);
    transition:
      width 0.25s cubic-bezier(0.22, 1, 0.36, 1),
      height 0.25s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.25s,
      background 0.25s;
  }
  .film-tick:hover .film-tick-dot {
    border-color: var(--coral);
  }
  .film-tick.is-active .film-tick-dot {
    width: 14px;
    height: 14px;
    background: var(--coral);
    border-color: var(--coral);
  }

  .film-tick-year {
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 520px) {
    .film-timeline { margin: 0 0.25rem; }
    .film-tick { font-size: 0.62rem; }
  }
</style>
